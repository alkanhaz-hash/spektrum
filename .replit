modules = ["python-base-3.13", "nodejs-24"]
[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 23422
externalPort = 3001

[[ports]]
localPort = 24811
externalPort = 3000

[[ports]]
localPort = 24812
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Spektrum API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Spektrum Web"

[[workflows.workflow]]
name = "Spektrum API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server dev"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Spektrum Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 pnpm --filter @workspace/spektrum dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "autoscale"
run = ["pnpm", "--filter", "@workspace/api-server", "start"]
build = ["bash", "-c", "pnpm --filter @workspace/spektrum build && pnpm --filter @workspace/api-server build"]

[userenv]

[userenv.development]

[userenv.shared]
