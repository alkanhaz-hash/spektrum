{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://spektrumapp.com.tr"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "22.16.0",
      "pnpm": "10.26.1",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://spektrumapp.com.tr"
      },
      "android": {
        "image": "ubuntu-24.04-jdk-17-ndk-r27b",
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "play-existing": {
      "extends": "production",
      "env": {
        "SPEKTRUM_ANDROID_TARGET": "existing-play",
        "SPEKTRUM_ANDROID_VERSION_CODE": "24"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
