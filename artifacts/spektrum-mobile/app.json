{
  "expo": {
    "name": "SPEKTRUM",
    "slug": "spektrum-mobile",
    "owner": "kerimd642",
    "version": "2.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spektrum",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "backgroundColor": "#100E19",
    "updates": {
      "enabled": false
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#100E19"
    },
    "ios": {
      "infoPlist": { "UIBackgroundModes": ["audio"] },
      "supportsTablet": false,
      "bundleIdentifier": "com.alkanhaz.spektrum2",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.alkanhaz.spektrum2",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#100E19"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CALL_LOG",
        "android.permission.WRITE_CALL_LOG"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/with-play-existing",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "extraProguardRules": "-keep class expo.modules.** { *; }\n-keep class expo.modules.kotlin.types.** { *; }\n-keep class com.facebook.react.** { *; }"
          }
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "SPEKTRUM fotoğraf seçmek için galeri erişimi istiyor.",
          "cameraPermission": "SPEKTRUM profil fotoğrafı çekmek için kamera erişimi istiyor.",
          "microphonePermission": false
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "publicWebsiteUrl": "https://spektrumapp.com.tr",
      "eas": {
        "projectId": "78619c66-ac99-49c1-93fd-b94a1e9441be"
      }
    }
  }
}
